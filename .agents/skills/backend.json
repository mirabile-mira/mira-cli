{
  "agent": "backend",
  "framework": "Node.js (Express)",
  "objectives": [
    "Implement business logic",
    "Handle API requests",
    "Manage database operations"
  ],
  "modules": [
    "inputParser",
    "roadmapGenerator",
    "companyIntelligence",
    "resourceRecommender",
    "progressCalculator"
  ],
  "api_endpoints": [
    {
      "method": "POST",
      "route": "/roadmap/generate",
      "description": "Generate roadmap from user input"
    },
    {
      "method": "GET",
      "route": "/roadmap/:userId",
      "description": "Retrieve user roadmap"
    },
    {
      "method": "POST",
      "route": "/notes",
      "description": "Add notes to roadmap step"
    },
    {
      "method": "PUT",
      "route": "/progress",
      "description": "Update progress"
    }
  ],
  "logic_requirements": [
    "parse role, company, domain",
    "generate 3-phase roadmap",
    "adapt roadmap based on company",
    "attach categorized resources",
    "calculate progress percentage"
  ],
  "database": {
    "type": "MongoDB",
    "collections": [
      "users",
      "roadmaps",
      "notes",
      "progress"
    ]
  }
}